---
import Base from "../../layouts/Base.astro";

const title = "Contact | Portugal Considered";
const description =
  "Contact Portugal Considered with questions, corrections, or other inquiries about our Portugal travel guidance.";
---

<Base title={title} description={description}>
  <section class="contact-intro">
    <div class="contact-inner">
      <p class="eyebrow">Contact</p>

      <h1>We would like to hear from you.</h1>

      <p class="intro">
        Have a question about Portugal Considered, noticed something that
        should be updated, or want to get in touch about our travel guidance?
        We welcome thoughtful inquiries.
      </p>
    </div>
  </section>

  <section class="contact-content">
    <div class="contact-inner">
      <h2>Questions and corrections</h2>

      <p>
        Travel information changes. Transportation schedules, hotels,
        attractions, reservation requirements, and other practical details
        can change after a guide is published.
      </p>

      <p>
        If you notice information that may need to be reviewed or corrected,
        we appreciate hearing about it.
      </p>

      <h2>Business inquiries</h2>

      <p>
        We are also happy to receive relevant inquiries concerning Portugal
        travel, tourism, accommodations, experiences, and potential business
        relationships.
      </p>

      <p>
        Editorial decisions remain independent. A business relationship does
        not guarantee coverage or a recommendation.
      </p>

      <div class="contact-note">
        <p class="eyebrow">Contact information</p>

        <p>
          A dedicated Portugal Considered contact email will be added before
          the site is publicly launched.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-intro {
    padding: 100px 28px 85px;
    text-align: center;
  }

  .contact-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 16px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-green);
  }

  h1 {
    margin: 0;
    font-family: Georgia, serif;
    font-size: clamp(44px, 6vw, 68px);
    line-height: 1.08;
    font-weight: 500;
  }

  .intro {
    max-width: 700px;
    margin: 28px auto 0;
    font-size: 20px;
    color: var(--color-muted);
  }

  .contact-content {
    padding: 70px 28px 85px;
    border-top: 1px solid var(--color-sand);
  }

  .contact-content h2 {
    margin: 55px 0 20px;
    font-family: Georgia, serif;
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.15;
    font-weight: 500;
  }

  .contact-content h2:first-child {
    margin-top: 0;
  }

  .contact-content p {
    font-size: 18px;
  }

  .contact-note {
    margin-top: 55px;
    padding: 32px;
    background: var(--color-sand);
  }

  .contact-note p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .contact-intro {
      padding: 70px 22px 60px;
    }

    .intro {
      font-size: 18px;
    }

    .contact-content {
      padding: 55px 22px 65px;
    }

    .contact-content p {
      font-size: 17px;
    }

    .contact-note {
      padding: 25px;
    }
  }
</style>
