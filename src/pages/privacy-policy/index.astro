---
import Base from "../../layouts/Base.astro";

const title = "Privacy Policy | Portugal Considered";
const description =
  "Privacy Policy for Portugal Considered, including information about website analytics, cookies, affiliate links, and third-party services.";
---

<Base title={title} description={description}>
  <section class="legal-page">
    <div class="legal-inner">
      <p class="eyebrow">Portugal Considered</p>

      <h1>Privacy Policy</h1>

      <p class="updated">Last updated: September 30, 2026</p>

      <p>
        Portugal Considered respects your privacy. This Privacy Policy explains
        the types of information that may be collected when you visit this
        website and how that information may be used.
      </p>

      <h2>Information We Collect</h2>

      <p>
        Portugal Considered may collect limited information automatically when
        you visit the website. This may include information such as your browser
        type, device type, pages visited, referring website, approximate
        location, and other general website usage information.
      </p>

      <p>
        If you contact us directly, we may receive the information you choose
        to provide, such as your name, email address, and the contents of your
        message.
      </p>

      <h2>Analytics</h2>

      <p>
        We may use website analytics services to understand how visitors find
        and use Portugal Considered. These services may collect information
        about website traffic and visitor interactions so that we can improve
        the usefulness and performance of the site.
      </p>

      <h2>Cookies</h2>

      <p>
        Portugal Considered and third-party services used by the website may
        use cookies or similar technologies. Cookies can help websites remember
        information, measure traffic, understand visitor behavior, and support
        certain advertising or affiliate functions.
      </p>

      <p>
        You can control or disable cookies through your browser settings.
        Disabling cookies may affect how some website features or third-party
        services function.
      </p>

      <h2>Affiliate Links</h2>

      <p>
        Portugal Considered may participate in affiliate programs. Some links
        on this website may be affiliate links. If you follow one of these
        links and make a qualifying purchase or booking, Portugal Considered
        may receive a commission at no additional cost to you.
      </p>

      <p>
        Affiliate partners and booking services may use cookies or other
        tracking technologies to determine whether a purchase or booking
        resulted from a referral from this website.
      </p>

      <h2>Third-Party Websites and Services</h2>

      <p>
        Portugal Considered may link to third-party websites, including hotels,
        tour operators, transportation providers, booking platforms, and other
        travel-related services. We are not responsible for the privacy
        practices or content of those third-party websites.
      </p>

      <p>
        We encourage you to review the privacy policies of any third-party
        service you choose to use.
      </p>

      <h2>Advertising</h2>

      <p>
        Portugal Considered may display advertising in the future. Advertising
        providers may use cookies or similar technologies to deliver, measure,
        or personalize advertising in accordance with their own privacy
        policies and applicable law.
      </p>

      <h2>Data Security</h2>

      <p>
        Reasonable measures are taken to protect information associated with
        this website. However, no method of transmission or storage on the
        internet can be guaranteed to be completely secure.
      </p>

      <h2>Changes to This Policy</h2>

      <p>
        This Privacy Policy may be updated as Portugal Considered develops,
        adds services, or changes the technologies used on the website. The
        date at the top of this page will be updated when material changes are
        made.
      </p>

      <h2>Contact</h2>

      <p>
        If you have questions about this Privacy Policy, please use our
        <a href="/contact/">Contact page</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .legal-page {
    padding: 85px 28px 90px;
  }

  .legal-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 14px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-green);
  }

  h1 {
    margin: 0 0 12px;
    font-family: Georgia, serif;
    font-size: clamp(44px, 6vw, 64px);
    line-height: 1.08;
    font-weight: 500;
  }

  .updated {
    margin: 0 0 42px;
    font-size: 14px;
    color: var(--color-muted);
  }

  .legal-inner h2 {
    margin: 45px 0 14px;
    font-family: Georgia, serif;
    font-size: 29px;
    line-height: 1.2;
    font-weight: 500;
  }

  .legal-inner p {
    margin: 0 0 20px;
    font-size: 17px;
  }

  .legal-inner a {
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .legal-page {
      padding: 60px 22px 65px;
    }

    .legal-inner p {
      font-size: 16px;
    }

    .legal-inner h2 {
      margin-top: 38px;
      font-size: 26px;
    }
  }
</style>
